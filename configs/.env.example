# Copy to .env next to docker-compose.yml and fill in what you need.

# Public address used in share links and QR codes.
SAT_SPLIT_BASE_URL=https://split.example.com

# Receipt reader: an OpenAI-compatible vision API. When VISION_URL is set the
# vision model is the only reader; without it Tesseract reads the receipt.
VISION_URL=https://api.openai.com
VISION_API_KEY=
VISION_MODEL=
# Optional second model, asked only when the first one's items do not add up
# to the printed total.
VISION_FALLBACK_MODEL=
# Optional: pass Tesseract's text to the vision model as a draft (1 to enable).
VISION_OCR_HINT=

# Translation service for item names typed by the host. Optional.
TRANSLATE_URL=http://translate:8001

# Defaults shown for reference.
SAT_SPLIT_ADDR=:8080
SAT_SPLIT_DB=/data/satsplit.db
SAT_SPLIT_UPLOAD_DIR=/data/uploads
TESSERACT_LANG=eng
